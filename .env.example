# Copy is created by scripts/setup-bootstrap.py — DO NOT commit your real .env
# This file documents variables only.

COMPOSE_PROJECT_NAME=vps-stack
APPDATA_ROOT=/opt/appdata/docker-apps
TZ=America/New_York

DOMAIN=yourdomain.com
CF_EMAIL=you@example.com

# token = paste connector token from Zero Trust (best for headless VPS)
# config = cloudflared CLI + config.yml on disk
CF_TUNNEL_MODE=token
CF_TUNNEL_TOKEN=
CF_TUNNEL_NAME=
CF_TUNNEL_ID=
CF_DNS_API_TOKEN=

SUBDOMAIN_TRAEFIK=traefik
SUBDOMAIN_PORTAINER=port
SUBDOMAIN_MANAGER=manager
SUBDOMAIN_AUTH=auth

TM_COOKIE_SECURE=true

# Filled by setup-authelia.py (phase 2)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# Optional Rocket.Chat (profile rocketchat)
SUBDOMAIN_ROCKETCHAT=sub
ROCKETCHAT_ROOT_URL=https://sub.yourdomain.com
ROCKETCHAT_IMAGE=registry.rocket.chat/rocketchat/rocket.chat:7.4.0
ROCKETCHAT_MONGO_PASSWORD=
