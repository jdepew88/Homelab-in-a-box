# Bootstrap + full stack — copy to .env and edit. DO NOT commit .env

COMPOSE_PROJECT_NAME=homelab-in-a-box
COMPOSE_DIR=/home/joe/homelab-in-a-box
APPDATA_ROOT=/opt/appdata/docker-apps
TZ=America/New_York

DOMAIN=jrtechconsult.com
PRIMARY_DOMAIN=jrtechconsult.com
CF_EMAIL=you@example.com

CF_TUNNEL_MODE=token
CF_TUNNEL_TOKEN=
CF_TUNNEL_NAME=
CF_TUNNEL_ID=
CF_DNS_API_TOKEN=

HOST_IP=127.0.0.1

SUBDOMAIN_TRAEFIK=traefik
SUBDOMAIN_PORTAINER=port
SUBDOMAIN_MANAGER=manager
SUBDOMAIN_AUTH=auth

TM_COOKIE_SECURE=true

# Phase 2 — Authelia (not required for bootstrap-only)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
AUTHELIA_DB_PASSWORD=

# Optional — Rocket.Chat (profile rocketchat; not required for bootstrap)
SUBDOMAIN_ROCKETCHAT=sub
ROCKETCHAT_ROOT_URL=https://sub.jrtechconsult.com
ROCKETCHAT_IMAGE=registry.rocket.chat/rocketchat/rocket.chat:7.4.0
ROCKETCHAT_MONGO_PASSWORD=
