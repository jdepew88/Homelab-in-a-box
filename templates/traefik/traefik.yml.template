# Static Traefik config — placeholders replaced by scripts/setup.py
#
# domain: __DOMAIN__
# cloudflare_email: __CF_EMAIL__

api:
  dashboard: true

log:
  level: INFO
  filePath: /var/log/traefik/traefik.log

accessLog:
  filePath: /var/log/traefik/access.log

entryPoints:
  web:
    address: ":80"

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: proxy
  file:
    directory: /etc/traefik/dynamic
    watch: true

