# Static Traefik config — Cloudflare Tunnel (internal HTTP :80)
# Rendered to: APPDATA_ROOT/traefik/traefik.yml

api:
  dashboard: true

log:
  level: INFO
  filePath: /var/log/traefik/traefik.log

accessLog:
  filePath: /var/log/traefik/access.log

entryPoints:
  web:
    address: ":80"

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: proxy
  file:
    directory: /etc/traefik/dynamic
    watch: true
