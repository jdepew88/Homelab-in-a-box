# Dynamic Traefik middlewares — bootstrap (no duplicate routers; Docker labels define routes)
# Rendered to: APPDATA_ROOT/traefik/dynamic/config.yml

http:
  middlewares:
    chain-no-auth:
      chain:
        middlewares:
          - rate-limit
          - securityHeaders
    rate-limit:
      rateLimit:
        average: 100
        burst: 50
    securityHeaders:
      headers:
        accessControlAllowMethods:
          - GET
          - OPTIONS
          - PUT
        browserXssFilter: true
        contentTypeNosniff: true
        customFrameOptionsValue: SAMEORIGIN
        customRequestHeaders:
          X-Forwarded-Proto: https
        customResponseHeaders:
          X-Forwarded-Proto: https
          X-Robots-Tag: "none,noarchive,nosnippet,notranslate,noimageindex"
        forceSTSHeader: true
        hostsProxyHeaders:
          - X-Forwarded-Host
        referrerPolicy: same-origin
        sslProxyHeaders:
          X-Forwarded-Proto: https
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 63072000
