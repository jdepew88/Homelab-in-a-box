# 3. Fill IMMICH_* vars in .env, then: docker compose -f compose.yaml -f compose.stacks/immich.compose.yaml --profile immich up -d
#
# See README "Immich + object storage" for bucket layout and backup notes.

services:
  immich-server:
    image: ghcr.io/immich-app/immich-server:release
    profiles: [immich]
